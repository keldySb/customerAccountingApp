openapi: 3.0.3

info:
  title: Customer Accounting API
  description: API системы учета клиентских заявок и сотрудников
  version: 1.0.0

servers:
  # Added by API Auto Mocking Plugin
  - description: SwaggerHub API Auto Mocking
    url: https://virtserver.swaggerhub.com/not-531/CustomerAccountingAPI/1.0.0
  - url: http://localhost:5000
    description: Локальный сервер

tags:
  - name: Authorization
    description: Авторизация сотрудников
  - name: Requests
    description: Работа с клиентскими заявками
  - name: Employees
    description: Работа с сотрудниками
  - name: Dictionaries
    description: Справочники системы

paths:
  /api/authorization/login:
    post:
      tags:
        - Authorization
      summary: Авторизация сотрудника
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
      responses:
        '200':
          description: Авторизация успешна
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Dispatcher'
        '400':
          description: Логин или пароль не указаны
        '401':
          description: Неверный логин или пароль

  /api/requests:
    get:
      tags:
        - Requests
      summary: Получить список заявок
      parameters:
        - name: search
          in: query
          required: false
          schema:
            type: string
          description: Поиск по данным заявки, клиенту, адресу и приоритету
        - name: statusId
          in: query
          required: false
          schema:
            type: integer
          description: Фильтрация по ID статуса
      responses:
        '200':
          description: Список заявок
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ClientRequest'

  /api/requests/{id}:
    put:
      tags:
        - Requests
      summary: Обновить заявку
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateClientRequest'
      responses:
        '204':
          description: Заявка обновлена
        '400':
          description: Некорректный ID заявки
        '404':
          description: Заявка не найдена

  /api/employees:
    get:
      tags:
        - Employees
      summary: Получить список сотрудников
      parameters:
        - name: search
          in: query
          required: false
          schema:
            type: string
          description: Поиск по табельному номеру, ФИО, должности и статусу
      responses:
        '200':
          description: Список сотрудников
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Employee'

  /api/employees/{id}/status:
    put:
      tags:
        - Employees
      summary: Изменить статус сотрудника
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '204':
          description: Статус сотрудника обновлен
        '400':
          description: Некорректный ID сотрудника
        '404':
          description: Сотрудник не найден

  /api/dictionaries/statuses:
    get:
      tags:
        - Dictionaries
      summary: Получить статусы заявок
      responses:
        '200':
          description: Список статусов
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/DictionaryItem'

  /api/dictionaries/priorities:
    get:
      tags:
        - Dictionaries
      summary: Получить приоритеты заявок
      responses:
        '200':
          description: Список приоритетов
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/DictionaryItem'

  /api/dictionaries/masters:
    get:
      tags:
        - Dictionaries
      summary: Получить список мастеров
      responses:
        '200':
          description: Список мастеров
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/DictionaryItem'

  /api/dictionaries/managers:
    get:
      tags:
        - Dictionaries
      summary: Получить список менеджеров
      responses:
        '200':
          description: Список менеджеров
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/DictionaryItem'

components:
  schemas:
    LoginRequest:
      type: object
      required:
        - login
        - password
      properties:
        login:
          type: string
          example: dispatcher1
        password:
          type: string
          format: password
          example: password123

    Dispatcher:
      type: object
      properties:
        id:
          type: integer
          example: 1
        employee_id:
          type: integer
          example: 5

    ClientRequest:
      type: object
      properties:
        id:
          type: integer
        fio:
          type: string
        address:
          type: string
        description:
          type: string
        status_id:
          type: integer
        status:
          type: string
        priority_id:
          type: integer
        priority:
          type: string
        manager_id:
          type: integer
          nullable: true
        manager:
          type: string
          nullable: true
        master_id:
          type: integer
          nullable: true
        master:
          type: string
          nullable: true
        created_time:
          type: string
          format: date-time
          nullable: true
        visit_time:
          type: string
          format: date-time
          nullable: true
        closed_time:
          type: string
          format: date-time
          nullable: true
        master_comment:
          type: string
          nullable: true

    UpdateClientRequest:
      type: object
      properties:
        priorityId:
          type: integer
        managerId:
          type: integer
          nullable: true
        masterId:
          type: integer
          nullable: true
        visitTime:
          type: string
          format: date-time
          nullable: true

    Employee:
      type: object
      properties:
        id:
          type: integer
        employee_number:
          type: string
        fio:
          type: string
        age:
          type: integer
        position_id:
          type: integer
        position:
          type: string
        experience:
          type: integer
        phone_number:
          type: string
        status_id:
          type: integer
        status:
          type: string

    DictionaryItem:
      type: object
      properties:
        id:
          type: integer
        name:
          type: string

<UserControl x:Class="finalExam_diplom_.controls.MainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:finalExam_diplom_.controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Style.Setters>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Width" Value="120"/>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="buttonBorder"
                                    Background="{TemplateBinding Background}">
                                                        <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"
                                    RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="buttonBorder" Property="Background" Value="#FFF0E6"/>
                                    <Setter Property="Foreground" Value="#E96518"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="buttonBorder" Property="Background" Value="#FFD6BD"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="buttonBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Style.Setters>
                <Setter Property="Background" Value="#F8F9FA"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style.Setters>
        </Style>

        <Style TargetType="DataGrid">
            <Style.Setters>
                <Setter Property="Background" Value="White"/>
                <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="MinRowHeight" Value="35"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="IsReadOnly" Value="True"/>
            </Style.Setters>
        </Style>

        <Style TargetType="Label">
            <Style.Setters>
                <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style.Setters>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="mainUCGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" x:Name="searchBorder">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="mainSearchLabel" Content="Поиск" HorizontalContentAlignment="Right" Grid.Column="0"/>
                <TextBox x:Name="mainTextBox" 
                     FontFamily="Bahnschrift Light" FontSize="16" BorderBrush="Gray" 
                     Height="25" Margin="10" TextChanged="mainTextBox_TextChanged" Grid.Column="1"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" x:Name="statusBorder">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            
            <Label x:Name="mainComboBoxLabel" 
                   Content="Выбор статуса" HorizontalContentAlignment="Center" Width="150" Grid.Column="0"/>
            <ComboBox x:Name="mainComboBox" 
                      FontFamily="Bahnschrift Light" FontSize="16" 
                      BorderBrush="white" Height="25" 
                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectedIndex="0" SelectionChanged="MainComboBox_SelectionChanged" Grid.Column="1"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="4">
            <DataGrid x:Name="mainDataGrid"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="Id" Header="#" Binding="{Binding Id}" Width="Auto"/>
                    <DataGridTextColumn x:Name="Fio" Header="ФИО" Binding="{Binding Fio}" Width="Auto"/>
                    <DataGridTextColumn x:Name="Address" Header="Адрес" Binding="{Binding Address}" Width="Auto"/>
                    <DataGridTextColumn x:Name="Reason" Header="Причина" Binding="{Binding Reason}" Width="*"/>
                    <DataGridTextColumn x:Name="Category" Header="Категория" Binding="{Binding Category}" Width="*"/>
                    <DataGridTextColumn x:Name="Duration" Header="Длительность" Binding="{Binding Duration}" Width="Auto"/>
                    <DataGridTextColumn x:Name="Description" Header="Описание" Binding="{Binding Description}" Width="Auto"/>
                    <DataGridTextColumn x:Name="Status_id" Header="Идентификатор статуса" Binding="{Binding Status_id}" Width="Auto" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="Status" Header="Статус" Binding="{Binding Status}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn x:Name="Priority_id" Header="Идентификатор приоритета" Binding="{Binding Priority_id}" Width="Auto" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="Priority" Header="Приоритет" Binding="{Binding Priority}" Width="Auto" IsReadOnly="True"/>
                    <DataGridTextColumn x:Name="Manager_id" Header="Идентификатор менеджерa" Binding="{Binding Manager_id}" Width="Auto" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="Manager" Header="Ответственный менеджер" Binding="{Binding Manager}" Width="Auto" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="Master_id" Header="Идентификатор мастерa" Binding="{Binding Master_id}" Width="Auto" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="Master" Header="Ответственный мастер" Binding="{Binding Master}" Width="Auto" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="Created_time" Header="Дата создания" Binding="{Binding Created_time}" Width="Auto" />
                    <DataGridTextColumn x:Name="Visit_time" Header="Дата визита" Binding="{Binding Visit_time}" Width="Auto" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="Closed_time" Header="Дата закрытия заявки" Binding="{Binding Closed_time}" Width="Auto" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="Master_comment" Header="Комментарий" Binding="{Binding Master_comment}" Width="Auto" Visibility="Collapsed"/>

                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="openApplication" Width="120" ToolTip="Открыть заявку" Click="openApplication_Click">
                                    <TextBlock Text="Открыть" Foreground="Black"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="setTaskFoeEmpColumn"  Width="100" Visibility="Collapsed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="setTaskForEmpButton" Width="150" ToolTip="Назначить задачу">
                                        <TextBlock Text="Назначить" Foreground="Black"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF0E6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

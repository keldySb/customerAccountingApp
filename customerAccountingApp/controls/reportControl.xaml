<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:finalExam_diplom_.controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             x:Class="finalExam_diplom_.controls.reportControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Style.Setters>
                <Setter Property="Background" Value="#dfd3c3"/>
                <Setter Property="Width" Value="180"/>
                <Setter Property="Height" Value="35"/>
                <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Margin" Value="0,20,0,0"/>
            </Style.Setters>
        </Style>
        <Style TargetType="TextBox">
            <Style.Setters>
                <Setter Property="Width" Value="250"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style.Setters>
        </Style>
        <Style TargetType="ComboBox">
            <Style.Setters>
                <Setter Property="Width" Value="250"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style.Setters>
        </Style>
        <Style TargetType="Label">
            <Style.Setters>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Margin" Value="30,0,0,0"/>
                <Setter Property="Padding" Value="0,10,0,0"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style.Setters>
        </Style>
        <Style TargetType="DatePicker">
            <Style.Setters>
                <Setter Property="Width" Value="250"/>
                <Setter Property="Height" Value="35"/>
                <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SelectedDateFormat" Value="Long"/>
            </Style.Setters>
        </Style>
    </UserControl.Resources>

    <Grid Background="white">
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Grid.Row="1">
            <lvc:PieChart x:Name="PieChart" SeriesSource="{Binding PieData}">
                <lvc:PieChart.SeriesTemplate>
                    <DataTemplate>
                        <lvc:XamlPieSeries SeriesName="{Binding Name}" Values="{Binding Value}"/>
                    </DataTemplate>
                </lvc:PieChart.SeriesTemplate>
                <lvc:PieChart.Title>
                    <lvc:XamlDrawnLabelVisual Text="{Binding Text}" Paint="#000" TextSize="20" />
                </lvc:PieChart.Title>
            </lvc:PieChart>
        </Border>

        <Border Grid.ColumnSpan="2" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <Label x:Name="EmployeeLabel" Content="Сотрудник"/>
                    <ComboBox x:Name="EmployeeComboBox"/>
                    <Label />
                    <TextBox />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <Label x:Name="StatusComboBox" Content="Статус заявки"/>
                    <ComboBox/>
                    <Label x:Name="PriorityComboBox" Content="Приоритет заявки"/>
                    <ComboBox/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <Label x:Name="DateFromDatePicker" Content="Дата с"/>
                    <DatePicker/>
                    <Label x:Name="DateToDatePicker" Content="Дата по"/>
                    <DatePicker/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Vertical">
                    <Button x:Name="PrintButton" Content="Распечатать"/>
                    <Button x:Name="BackDefaultSettingsButton" Content="Сбросить изменения"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

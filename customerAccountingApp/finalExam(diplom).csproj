    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
